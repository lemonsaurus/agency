#!/usr/bin/env bash
# agency-spawn requests a child, replacement, or promotion from an agency pane.
#
# Usage:
#   agency-spawn claude --label "Task name" [--dir /path]
#   agency-spawn --cmd "aider --yes" --label "Task name" [--dir /path]
#   agency-spawn --replace
#   agency-spawn --request-promotion "reason"

set -euo pipefail

if [[ -z "${AGENCY_SOCKET:-}" ]]; then
    echo "Error: AGENCY_SOCKET not set. Are you inside an agency session?" >&2
    exit 1
fi

if [[ ! -S "$AGENCY_SOCKET" ]]; then
    echo "Error: Socket $AGENCY_SOCKET does not exist." >&2
    exit 1
fi

send_message() {
    if command -v socat &>/dev/null; then
        printf '%s\n' "$1" | socat - "UNIX-CONNECT:$AGENCY_SOCKET"
    elif command -v nc &>/dev/null; then
        printf '%s\n' "$1" | nc -U "$AGENCY_SOCKET"
    else
        echo "Error: Need socat or nc (netcat) installed." >&2
        exit 1
    fi
}

json_escape() {
    local value=$1
    value=${value//\\/\\\\}
    value=${value//\"/\\\"}
    value=${value//$'\n'/\\n}
    value=${value//$'\r'/\\r}
    value=${value//$'\t'/\\t}
    printf '%s' "$value"
}

if [[ "${1:-}" == "--replace" ]]; then
    send_message "replace"
    exit
fi

if [[ "${1:-}" == "--request-promotion" ]]; then
    shift
    REASON="${*:?Usage: agency-spawn --request-promotion \"reason\"}"
    send_message "promotion-request:{\"reason\":\"$(json_escape "$REASON")\"}"
    exit
fi

ROLE="$(agency whoami --role 2>/dev/null || true)"
if [[ -z "$ROLE" ]]; then
    ROLE="${AGENCY_ROLE:-}"
fi
case "$ROLE" in
    controller) CHILD_ROLE="manager" ;;
    manager) CHILD_ROLE="worker" ;;
    worker)
        echo "Error: worker panes cannot spawn." >&2
        exit 1
        ;;
    *)
        echo "Error: Cannot determine agency pane role." >&2
        exit 1
        ;;
esac

DIR=""
LABEL=""
ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --label)
            LABEL="${2:?Usage: agency-spawn ... --label 'Task name'}"
            shift 2
            ;;
        --dir)
            DIR="${2:?Usage: agency-spawn ... --dir /path}"
            shift 2
            ;;
        *)
            ARGS+=("$1")
            shift
            ;;
    esac
done
set -- "${ARGS[@]}"

if [[ -z "$DIR" ]]; then
    DIR="$PWD"
fi

if [[ "${1:-}" == "--cmd" ]]; then
    shift
    COMMAND="${*:?Usage: agency-spawn --cmd \"command\"}"
    MSG="spawn-role:{\"command\":\"$(json_escape "$COMMAND")\",\"dir\":\"$(json_escape "$DIR")\",\"role\":\"$CHILD_ROLE\",\"label\":\"$(json_escape "$LABEL")\"}"
else
    AGENT="${1:?Usage: agency-spawn <agent-type> or agency-spawn --cmd \"command\"}"
    MSG="spawn-role:{\"agent\":\"$(json_escape "$AGENT")\",\"dir\":\"$(json_escape "$DIR")\",\"role\":\"$CHILD_ROLE\",\"label\":\"$(json_escape "$LABEL")\"}"
fi

send_message "$MSG"
